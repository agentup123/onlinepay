# Copy to .env at the repo root (apps load it via dotenv). NEVER commit real values.

NODE_ENV=development

# --- URLs ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Data stores ---
DATABASE_URL=postgresql://onlinepay:onlinepay@localhost:5432/onlinepay?schema=public
REDIS_URL=redis://localhost:6379

# --- Security ---
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-session-secret-at-least-32-chars
OTP_PEPPER=change-me-otp-pepper-at-least-32-chars
COOKIE_SECURE=false

# --- Business rules (pending founder confirmation — see docs/DECISIONS.md) ---
BUNDLE_MODE=one_time                       # one_time | subscription
CANCELLED_CARDS_COUNT_AGAINST_BUNDLE=true  # true | false
CANCELLED_CARD_BALANCE_DESTINATION=wallet  # wallet | source
VAT_RATE_BPS=500                           # 5.00% UAE VAT
COMPANY_TRN=TRN-PLACEHOLDER                # UAE Tax Registration Number for invoices

# --- NymCard ---
NYMCARD_MODE=mock                          # mock | sandbox | production
NYMCARD_BASE_URL=                          # TODO(nymcard-docs): sandbox/prod base URL
NYMCARD_API_KEY=
NYMCARD_API_SECRET=
NYMCARD_PRODUCT_ID=                        # virtual card product configured by NymCard
NYMCARD_WEBHOOK_SECRET=dev-webhook-secret
NYMCARD_WEBHOOK_SIGNATURE_HEADER=x-nymcard-signature  # TODO(nymcard-docs): confirm header + scheme

# --- Payment gateway ---
PAYMENT_GATEWAY=mock                       # mock | checkoutcom
CHECKOUTCOM_SECRET_KEY=
CHECKOUTCOM_PROCESSING_CHANNEL_ID=
CHECKOUTCOM_WEBHOOK_SECRET=
CHECKOUTCOM_BASE_URL=https://api.sandbox.checkout.com

# --- KYC ---
KYC_PROVIDER=mock                          # mock | (add real provider)
KYC_MOCK_AUTO_APPROVE=true

# --- Messaging ---
SMS_PROVIDER=console                       # console | (add real provider)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="OnlinePay <no-reply@onlinepay.local>"

# --- Admin seed ---
SEED_ADMIN_EMAIL=admin@onlinepay.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# --- Monitoring thresholds ---
MONITOR_HIGH_AMOUNT_FILS=500000            # 5,000 AED
MONITOR_VELOCITY_COUNT=5                   # auths per 10 minutes
MONITOR_DECLINE_COUNT=3                    # declines per hour
MONITOR_RISKY_MCCS=7995,6051,4829          # gambling, quasi-cash/crypto, money transfer
